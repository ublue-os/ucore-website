---
import '../styles/tokens.css';
import '../styles/site.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThemeProvider from '../components/starlight/ThemeProvider.astro';
import { markdownPath } from '../lib/markdown';

interface Props {
	title: string;
	description: string;
	ignoreSearch?: boolean;
	canonicalPage?: boolean;
}

const { title, description, ignoreSearch = false, canonicalPage = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={`${title} | uCore`} />
		<meta property="og:description" content={description} />
		{canonicalPage && <link rel="canonical" href={canonical} />}
		{canonicalPage && <link rel="alternate" type="text/markdown" href={markdownPath(Astro.url.pathname)} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="uCore announcements" href="/feed.xml" />
		<slot name="head" />
		<title>{title} | uCore</title>
		<ThemeProvider />
		<script is:inline>
			try {
				if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
					document.documentElement.classList.add('reveal-ready');
				}
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main
			id="main"
			class="page-main"
			data-pagefind-body={!ignoreSearch ? '' : undefined}
			data-pagefind-ignore={ignoreSearch ? '' : undefined}
		>
			<slot />
		</main>
		<SiteFooter markdown={canonicalPage} />
		<script>
	const revealTargets = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
	if (revealTargets.length) {
		const showAll = () => revealTargets.forEach((target) => { target.dataset.reveal = 'in'; });
		if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
			showAll();
		} else {
			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					const target = entry.target as HTMLElement;
					target.dataset.reveal = 'in';
					observer.unobserve(target);
				}
			}, { rootMargin: '0px 0px -8% 0px' });
			revealTargets.forEach((target) => observer.observe(target));
			window.setTimeout(() => {
				showAll();
				observer.disconnect();
			}, 1500);
		}
		}
		</script>
	</body>
</html>
